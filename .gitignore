# ---- .NET build output ----
bin/
obj/
dist/
*.user
*.suo
*.sourcelink.json

# ---- Python ----
# Per-chat Codex continuation state stays local; keep the hook/config sources tracked.
/.codex/checkpoints/
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
env/
*.egg-info/
.pytest_cache/

# ---- Managed runtimes: vendored deps and downloaded model weights ----
# Bridge/.runtime and Research/omr/.runtime hold multi-hundred-MB checkpoints
# (model.safetensors alone is 114MB) and vendored site-packages.
.runtime/

# ---- Song library ----
# Sheet music, MIDI and generated caches are user content: large, machine-specific,
# and largely third-party copyrighted arrangements. Keep them local.
Visualization_engine/songs/
Visualization_engine/assets/fonts/*.otf

# ---- SFZ piano sample sets ----
# 2.6GB of third-party samples loaded by VirtualMIDISynth, not by this app.
# The synth resolves them from its own VirtualMIDISynth.conf; nothing here reads them.
pianos/

# ---- SoundFonts for the built-in synthesiser ----
# Tens to hundreds of megabytes of third-party samples. scripts/install-soundfont.ps1
# fetches one and verifies its hash, so the binary stays out of git the same way the
# model weights do. The folder's README.txt is tracked; the .sf2 files are not.
Visualization_engine/assets/soundfonts/*.sf2
Visualization_engine/assets/soundfonts/*.txt
!Visualization_engine/assets/soundfonts/README.txt

# Transient experiment output. The conclusions live in reports/diagnosis/FINDINGS.md and
# are reproducible from the scripts; these are working files, several from hypotheses that
# were tested and refuted, and the cached predictions regenerate with diagnose_rhythm.py.
Research/omr/reports/*.log
Research/omr/reports/diagnosis/*.log
Research/omr/reports/diagnosis/predictions/
Research/omr/reports/library/predictions/

# ---- Report data that names a personal library or an absolute local path ----
# These regenerate from the scripts, and their content is either one person's music collection
# or a filesystem layout with a username in it. The measurement *summaries* stay tracked; the
# manifests and per-song reports do not.
Research/omr/reports/library/*.json
Research/omr/reports/phase3/olimpic-scanned-*.jsonl
Research/omr/reports/phase3-smoke/olimpic-scanned-*.jsonl

# ---- Source scores ----
# Same policy as the song library above: third-party arrangements stay local, including the
# Data_Pipeline inputs that were tracked by mistake.
Omr/Data_Pipeline/input_xml/
# Rebuilt MusicXML from roundtrip_oracle.py --keep-xml: regenerates in seconds, 1.5 MB.
Research/omr/reports/diagnosis/oracle-corrected/
Research/omr/reports/pv_on/
Research/omr/reports/pv_off/
Research/omr/reports/tup_on/
Research/omr/reports/tup_off/
Research/omr/reports/canary_070/
Research/omr/reports/canary_git/
Research/omr/reports/homr_git/
Research/omr/reports/comparison/

# ---- OMR research ----
# Track the code (Research/omr/src, run_*.py, pyproject.toml, lock files, reports);
# ignore only the heavy generated inputs and outputs.
Research/omr/data/
Research/omr/artifacts/
Research/omr/out/
Research/omr/out_zeus_test/
Research/omr/zeus_eval_tmp_*/
Research/omr/src/test_zeus_out/

# Model checkpoints - keep the code that trains and loads them, not the weights.
*.h5
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
Omr/__pycache__/
Omr/Data_Pipeline/output_svg/

# ---- Pipeline scratch output ----
zeus_e2e_out/
zeus_test_out*/
tmp/

# ---- Editor / OS ----
.vs/
.idea/
*.swp
.DS_Store
Thumbs.db
Research/omr/dataset/
Research/omr/vendor/
Bridge/.runtime/
Research/omr/reports/homr-465-app-integration/phase*/

# Unreferenced sample score, kept locally but not distributed under the repo licence.
Omr/test_sheet.jpg

# ---- Bulky research evidence: kept on disk, not distributed ----
# Page renders, debug images, worker logs, raw OMR attempts, pickles and archives are
# reproduction detail for the reports beside them. Summaries, manifests and handoffs
# stay tracked.
Research/omr/reports/**/attempts/
Research/omr/reports/**/raw/
Research/omr/reports/**/*.png
Research/omr/reports/**/*.jpg
Research/omr/reports/**/*.jpeg
Research/omr/reports/**/*.log
Research/omr/reports/**/*.jsonl
Research/omr/reports/**/*.pickle
Research/omr/reports/**/*.tar
Research/omr/reports/**/*.gz
