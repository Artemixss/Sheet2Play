# Displacement plan: supervisor receipts and capture identities hold local user paths; keep them local.
Research/omr/reports/displacement/phase*/jobs/
Research/omr/reports/displacement/phase*/capture-identity.json
# Phase 2's full attribution (3.7 MB of events) rebuilds from the local captures; ledger.json is tracked.
Research/omr/reports/displacement/phase2/attribution.json
# The replan's per-measure ledger rebuilds from the local captures with displacement_meter.py.
Research/omr/reports/displacement/phase3b/meter-ledger.json
# Phase 4's live end-to-end output is a full engine payload; the job receipt records the run.
Research/omr/reports/displacement/phase4/e2e/
# Remaining-timing and upstream-480 receipts hold local paths too; the anchor ledger rebuilds
# from the local captures with timing_meter.py.
Research/omr/reports/timing/phase*/jobs/
Research/omr/reports/timing/phase2/anchor-ledger.json
Research/omr/reports/upstream-480/jobs/
# MusicXML songs: the app's library listings and conversion receipts name private songs and paths.
