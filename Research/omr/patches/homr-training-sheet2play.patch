+    def _read_note_attacks(self, measure: ET.Element) -> list[tuple[int, int, str, str, str]]:
+        """Non-chord-tone note events as (attack, duration, pitch, staff, voice)."""
+        cursor = 0
+        events = []
+        for el in measure:
