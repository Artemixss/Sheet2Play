     nominator: Fraction = np.median(measure_duration)  # type: ignore
 
+    # Sheet2Play change, opt-in via SHEET2PLAY_EXPECTED_MODE=1. The median is what decides
+    # whether a measure counts as over-long, and PR #146's re-timing then shrinks measures to
+    # match it. When several measures decode short the median follows them down, correctly
+    # timed measures start looking over-long, and the repair damages them - which is what the
+    # measured regressions look like: span 1.00 going to 0.88. A measure length that a strict
+    # majority of measures agree on exactly is better evidence than the middle of a spread, so
+    # prefer it when it exists and fall back to the median when it does not.
+    if os.environ.get("SHEET2PLAY_EXPECTED_MODE") == "1" and measure_duration:
+        counts = Counter(measure_duration)
+        candidate, agreeing = counts.most_common(1)[0]
+        if agreeing * 2 > len(measure_duration):
+            nominator = candidate
+
     return find_common_division(durations), nominator
 
 
