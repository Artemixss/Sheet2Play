+                    if pitch is not None
+                    else "rest"
+                )
+                events.append(
+                    (cursor, duration, name, el.findtext("staff", "1"), el.findtext("voice", ""))
+                )
+                cursor += duration
+            elif el.tag == "backup":
+                cursor -= int(el.findtext("duration", "0"))
