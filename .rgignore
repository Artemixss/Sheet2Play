**/env/
**/site-packages/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.runtime/
**/bin/
**/obj/
/dist/
/tmp/
/pianos/
/Research/omr/data/
/Research/omr/dataset/
/Research/omr/vendor/
/Research/omr/zeus/source/
/Research/omr/zeus/weights/
